# ==============================================================================
# Public Variables (Client & Server)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-placeholder"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================================================
# Server-Only Confidential Secret (STRICTLY SERVER-ONLY - Never expose to client)
# ==============================================================================
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-placeholder"

# Keyed HMAC-SHA-256 secret for cryptographic flag hashing (Server-only)
FLAG_SALT_SECRET="your-secure-server-only-flag-secret-min-32-chars"

# Transactional Email Service (Resend or SMTP for download email verification)
RESEND_API_KEY=""
EMAIL_FROM="Techythrone Security <noreply@yourdomain.com>"
# Optional SMTP configuration
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"

# ==============================================================================
# Admin Bootstrap Configuration (Used only during manual bootstrap execution)
# IMPORTANT: Real credentials must NEVER be placed in .env.example or committed to git!
# Injected locally via untracked .env.local or interactive CLI prompt.
# ==============================================================================
ADMIN_BOOTSTRAP_EMAIL="admin@example.local"
ADMIN_BOOTSTRAP_PASSWORD="" # Injected locally via .env.local or CLI prompt; empty in example

# ==============================================================================
# Automated Testing Credentials (Used exclusively by Playwright CI runs)
# IMPORTANT: Injected via CI environment secrets or local untracked .env.test.local!
# ==============================================================================
TEST_ADMIN_EMAIL="admin-test@example.local"
TEST_ADMIN_PASSWORD="" # Injected via CI secret or untracked .env.test.local
TEST_USER_EMAIL="user-test@example.local"
TEST_USER_PASSWORD="" # Injected via CI secret or untracked .env.test.local
